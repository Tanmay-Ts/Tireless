# Copy to .env and adjust. Never commit .env.
COCKPIT_URL=http://localhost:4010      # :5173 in npm dev mode
API_URL=http://localhost:4000
ORG_ID=flytbase
SEED=42
SPEED=1
HEADED=1                               # 0 = headless (video is still recorded)
KIT_DIR=/absolute/path/to/flytbase-ahc-swe-qa-hackathon   # for npm run mutants (applies/reverts patches there)
# STALE_MS=3000                        # truth: no frames for this long = stale
# GRACE_MS=5000                        # UI gets this long to show staleness

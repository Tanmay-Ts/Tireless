# Copy to .env and adjust. Never commit .env.
COCKPIT_URL=http://localhost:4010      # :5173 in npm dev mode
API_URL=http://localhost:4000
ORG_ID=flytbase
SEED=42
SPEED=1
HEADED=1                               # 0 = headless (video is still recorded)
# Optional overrides if auto-discovery gets it wrong (see `npm run probe`):
# TAKEOFF_ENDPOINT=POST /api/control/drone/{id}/takeoff
# LAND_ENDPOINT=POST /api/control/drone/{id}/land
# FAULT_KEY=type                       # body key for POST /api/control/fault
# TRUTH_TOPICS=telemetry/global_position,telemetry/heartbeat
# STALE_MS=3000                        # truth: no frames for this long = stale
# GRACE_MS=5000                        # UI gets this long to show staleness
